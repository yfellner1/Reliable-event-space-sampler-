# Supabase project (Project Settings > API keys).
NEXT_PUBLIC_SUPABASE_URL=
# The publishable key (sb_publishable_...) or the legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. The secret key (sb_secret_...) or the legacy service_role key.
# Used to create and manage user accounts. Never expose it to the browser.
SUPABASE_SECRET_KEY=

# Usernames are stored in Supabase Auth as <username>@<this domain>.
# No email is ever sent to these addresses. Do not change after launch.
AUTH_EMAIL_DOMAIN=users.partybooking.invalid

# Daily reminder (Settings > Daily reminder). Each channel turns on when its
# keys are set. CRON_SECRET guards the hourly job (Vercel sends it).
CRON_SECRET=
# Email through Resend (needs a verified domain).
RESEND_API_KEY=
REMINDER_EMAIL_FROM="Event bookings <reminders@your-domain.com>"
# WhatsApp through Periskope: API key, and the phone number connected in Periskope.
PERISKOPE_API_KEY=
PERISKOPE_PHONE=
# Optional: the app's public address for links (defaults to the Vercel production URL).
APP_URL=
